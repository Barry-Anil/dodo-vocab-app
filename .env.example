# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Create a project at https://neon.tech, copy the pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── NextAuth (Auth.js v5) ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── AI Provider ───────────────────────────────────────────────────────────
# Which AIService implementation is active — "groq" (default) or "anthropic".
# Only the selected provider's API key is required; the other can be left
# blank. Swapping providers is just changing this value and restarting.
AI_PROVIDER=groq

# Groq (https://console.groq.com/keys) — fast, cheap, generous free tier.
GROQ_API_KEY=
# Model for complex generation tasks (word details, weekly reports, quizzes)
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
# Cheaper/faster model for simple tasks (sentence evaluation, vocabulary extraction)
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Anthropic Claude (https://console.anthropic.com) — alternative provider.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# ── Rate limiting (optional — Phase 12 upgrade path) ─────────────────────
# Only needed if/when the DB-backed rate limiter is swapped for Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
